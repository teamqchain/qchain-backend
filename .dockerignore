# =============================================================================
# .dockerignore for docker/Dockerfile (build context = the repository root)
# =============================================================================
# The Dockerfile copies only the Go source folders (main package, api, config,
# db, ledger, pqc, cmd) by name. This list keeps everything else out of the
# build context, so the upload to the Docker daemon stays small and secrets
# never reach it.
# =============================================================================

# Secrets and local settings: .env holds the issuer's ML-DSA-44 private key
# and the MySQL DSN. It must never enter a build context.
.env
.env.*

# Version control and CI
.git
.gitignore
.github

# Not part of the API image
docker/
gateway/
scripts/
tests/
db/schema.sql
*.md
LICENSE

# Test binaries and coverage output
*.test
*.out

# Editors and OS
.vscode/
.idea/
**/.DS_Store
