# QChain backend settings. Copy to .env (repository root), fill in, then: chmod 600 .env
# docker/docker-run.sh passes this file to the qchain-api container.

# --- The organisation's ML-DSA-44 issuer key pair (hex). Generate it once with:
#     go run ./cmd/keygen        (or: docker run --rm qchain-api:latest keygen)
ISSUER_PRIVATE_KEY_HEX=<from keygen>
ISSUER_PUBLIC_KEY_HEX=<from keygen>
ISSUER_ORG_ID=GeneralMSP

# --- Fabric identities the backend uses (wallet/<org>/<identity>.id in qchain-network)
ISSUER_ORG=general
ISSUER_IDENTITY=issuer1
VERIFIER_ORG=general
VERIFIER_IDENTITY=verifier1

# --- Fabric network
# docker-run.sh mounts the qchain-network clone at /qchain-network and sets this itself.
NETWORK_ROOT=/qchain-network
CHANNEL_NAME=mychannel
CHAINCODE_NAME=qchaincode
GOV_PEER_ENDPOINT=peer0.government.uae.com:27051
GEN_PEER_ENDPOINT=peer0.general.uae.com:29051
# Optional TLS host-name overrides (default: the peer's host name)
# GOV_GATEWAY_PEER=peer0.government.uae.com
# GEN_GATEWAY_PEER=peer0.general.uae.com

# --- MySQL and IPFS
MYSQL_DSN=<user>:<password>@tcp(127.0.0.1:3306)/qchain_db
IPFS_HOST=127.0.0.1:5001

# --- HTTP
SERVER_PORT=3000

# --- One-shot: re-register holders from MySQL on a freshly reset ledger, then remove it.
# RUN_CHAIN_BOOTSTRAP=1
